# Copy to .env and fill in. NEVER commit .env.
LLM_BASE_URL=https://api.metisai.ir/openai/v1
LLM_API_KEY=
CHAT_MODEL=
EXTRACT_MODEL=
# Set EMBED_MODEL for embeddings. If blank, hybrid job ranking falls back
# to skill overlap only (without embeddings).
EMBED_MODEL=
SCRAPER_USER_AGENT=CareerPathHackathonBot/0.1 (+contact: your-team@example.com)
# Shared JSON/repair budget per call (s); SDK retries disabled. 8 s timed out on cold calls.
LLM_TIMEOUT_S=20
LLM_JSON_BUDGET_S=20
# Embedding batches of postings need longer than a chat turn.
EMBED_TIMEOUT_S=60
# Set false only if organiser gateway does not support JSON object mode.
LLM_JSON_MODE=true
# Enable only if configured model accepts temperature.
LLM_SEND_TEMPERATURE=false
# Operator estimates, USD per million input/output tokens. Use exact configured IDs.
# Fill PRICE_TABLE with confirmed gateway model IDs and prices once selected.
PRICE_TABLE={"gpt-5.4-mini": [0.8625, 5.175], "text-embedding-3-large": [0.143, 0]}
PRICE_BASIS=metisai gateway price list (USD per 1M tokens), 29 Oct 2026
